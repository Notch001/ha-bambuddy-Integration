  "exceptions": {
    "no_control_permission": {
      "message": "The API key may not control the printer. Enable the \"control printer\" permission for the API key in Bambuddy."
    },
    "action_rejected": {
      "message": "Bambuddy rejected the action: {detail}"
    },
    "cannot_connect": {
      "message": "Cannot reach Bambuddy: {detail}"
    },
    "printer_not_found": {
      "message": "This device is not a Bambuddy printer."
    },
    "job_not_found": {
      "message": "Job {job_id} is not in the queue."
    },
    "job_not_movable": {
      "message": "Only waiting jobs can be moved or deleted."
    },
    "file_not_found": {
      "message": "No print or file matching \"{name}\" found."
    },
    "file_ambiguous": {
      "message": "Several files match: {names}. Please be more specific or use the ID."
    }
  },
  "services": {
    "clear_plate": {
      "name": "Mark build plate cleared",
      "description": "Tells Bambuddy the build plate is free so the next job can start.",
      "fields": {
        "device_id": {
          "name": "Printer",
          "description": "The Bambuddy printer."
        }
      }
    },
    "move_job_to_front": {
      "name": "Move job to front",
      "description": "Moves a waiting job to the first place in the queue.",
      "fields": {
        "job_id": {
          "name": "Job ID",
          "description": "The ID from the jobs attribute or the to-do list."
        }
      }
    },
    "cancel_job": {
      "name": "Skip job",
      "description": "Cancels a waiting job and removes it from the queue.",
      "fields": {
        "job_id": {
          "name": "Job ID",
          "description": "The ID from the jobs attribute or the to-do list."
        }
      }
    },
    "start_job": {
      "name": "Start job",
      "description": "Starts a job that waits for a manual start.",
      "fields": {
        "job_id": {
          "name": "Job ID",
          "description": "The ID from the jobs attribute or the to-do list."
        }
      }
    },
    "print_again": {
      "name": "Print again",
      "description": "Puts an earlier print from Bambuddy's archive back into the queue.",
      "fields": {
        "name": {
          "name": "Name",
          "description": "Name of the print; the newest match is used."
        },
        "archive_id": {
          "name": "Archive ID",
          "description": "Instead of the name."
        },
        "device_id": {
          "name": "Printer",
          "description": "Optional; otherwise the printer it was last printed on."
        }
      }
    },
    "print_file": {
      "name": "Print file",
      "description": "Puts a file from Bambuddy's library into the queue.",
      "fields": {
        "name": {
          "name": "Name",
          "description": "File name or part of it."
        },
        "file_id": {
          "name": "File ID",
          "description": "Instead of the name."
        },
        "device_id": {
          "name": "Printer",
          "description": "Which printer to print on."
        }
      }
    }
  }
