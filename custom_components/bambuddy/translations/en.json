{
  "config": {
    "step": {
      "user": {
        "title": "Bambuddy",
        "description": "Connect Home Assistant to your Bambuddy server.",
        "data": {
          "url": "Bambuddy URL",
          "api_key": "API key",
          "verify_ssl": "Verify SSL certificate"
        },
        "data_description": {
          "url": "For example http://192.168.1.50:8000 – the same address you open Bambuddy with in your browser.",
          "api_key": "Create one in Bambuddy under Settings → API keys (the \"read status\" permission is enough). Leave empty if Bambuddy has authentication disabled."
        }
      },
      "reauth_confirm": {
        "title": "Bambuddy: renew API key",
        "description": "Bambuddy at {url} rejected the API key. Please enter a valid API key.",
        "data": {
          "api_key": "API key"
        }
      }
    },
    "error": {
      "cannot_connect": "Bambuddy cannot be reached at this address.",
      "invalid_auth": "The API key is missing, invalid or lacks the \"read status\" permission.",
      "unknown": "Unexpected error, see the Home Assistant log."
    },
    "abort": {
      "already_configured": "This Bambuddy server is already configured.",
      "reauth_successful": "API key updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Bambuddy options",
        "data": {
          "scan_interval": "Polling interval (seconds)",
          "enable_costs": "Create cost sensors (filament, energy)",
          "notify_targets": "Notification targets"
        },
        "data_description": {
          "enable_costs": "Filament and energy costs from Bambuddy. Energy needs smart plugs set up in Bambuddy.",
          "notify_targets": "Where \"Notify when done\" sends to, e.g. mobile_app_your_phone. Empty = notification inside Home Assistant."
        }
      }
    }
  },
